    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst clean = (v, max) => String(v == null ? '' : v).replace(/[<>]/g, '').trim().slice(0, max);\nconst slug = clean(b.slug || 'capest', 60).replace(/[^a-z0-9-]/gi, '');\n// Anti-spam: campo trampa lleno o formulario enviado en menos de 3 segundos\nconst spam = !!clean(b.hp, 50) || (Number(b.elapsedMs) || 0) < 3000;\nconst payload = {\n  name: clean(b.name, 120), phone: clean(b.phone, 25), email: clean(b.email, 120),\n  propertyType: clean(b.propertyType, 20), pestType: clean(b.pestType, 60),\n  commune: clean(b.commune, 80), address: clean(b.address, 200),\n  serviceFrequency: clean(b.serviceFrequency, 20), message: clean(b.message, 600),\n  date: clean(b.date, 10), block: clean(b.block, 30), source: 'website'\n};\nreturn [{ json: { slug, spam, payload: JSON.stringify(payload) } }];"
      },
      "id": "7b7ba02f-6171-4a00-8de0-1d2ee522c174",
      "name": "Validar y limpiar",
      "type": "n8n-nodes-base.code",
