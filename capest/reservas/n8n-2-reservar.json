    {
      "parameters": {
        "jsCode": "const r = $input.first().json.r || { ok: false, error: 'error_interno' };\nlet aviso = '';\nif (r.ok) {\n  const d = r.data;\n  aviso = [\n    'Nueva solicitud de visita ' + d.codigo,\n    d.fecha + ' · ' + d.etiqueta + ' (' + d.hora_desde + ' a ' + d.hora_hasta + ')',\n    'Cliente: ' + d.nombre + ' · ' + d.telefono,\n    'Dirección: ' + d.direccion + ', ' + d.comuna,\n    'Plaga: ' + d.plaga,\n    'Confirmar en el panel o por WhatsApp.'\n  ].join('\\n');\n}\nreturn [{ json: { respuesta: r, ok: !!r.ok, aviso } }];"
      },
